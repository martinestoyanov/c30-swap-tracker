rules_version = '2';
// Firestore security rules for the C30 AWD Swap tracker.
// Paste into Firebase Console -> Firestore Database -> Rules -> Publish.
//
// Model: PUBLIC READ, RESTRICTED WRITE.
//   - Anyone can read the shared tracker document (read-only public viewing).
//   - Only the two project accounts may write. Accounts are Firebase
//     email/password users (martin@c30swap.app, evi@c30swap.app) created
//     via the Identity Toolkit API at deploy time. Passwords live only in
//     Firebase Auth — never in this repo or the client bundle.

service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/c30-awd-swap/state/shared {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'martin@c30swap.app',
          'evi@c30swap.app'
        ];
    }

    // VIDA import config: holds the Storage index URL for the workshop
    // manual section. Auth-only read — the index URL chains to every
    // imported document, so it must not leak to anonymous users.
    // Writes come from the import script with project-owner credentials
    // (admin path bypasses these rules), so client writes are denied.
    match /projects/c30-awd-swap/state/vida {
      allow read: if request.auth != null
        && request.auth.token.email in [
          'martin@c30swap.app',
          'evi@c30swap.app'
        ];
      allow write: if false;
    }
  }
}
