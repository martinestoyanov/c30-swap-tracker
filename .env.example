# Firebase config for cloud sync. Copy this file to ".env.local" and fill in
# the values from your Firebase project (see README.md, step 2).
# .env.local is gitignored and never committed.
#
# For the GitHub Pages build, these same names go into repo
# Settings -> Secrets and variables -> Actions (see README.md, step 4).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
